DATABASE_URL="postgresql://postgres:password@localhost:5432/kerala_psc"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
PORT=5000
FRONTEND_URL="http://localhost:5173"

# Optional OpenAI-compatible server-side AI adapter for hints only.
# No client key is exposed. Leave unset to use stored questions/scoring fully.
AI_PROVIDER="openai-compatible"
AI_API_URL=""
AI_API_KEY=""
AI_MODEL="default"
AI_RPM="10"
AI_TIMEOUT_MS="15000"
AI_MAX_TOKENS="180"

# Optional OpenAI-compatible fallback, for example Groq.
AI_FALLBACK_API_URL=""
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL="openai/gpt-oss-20b"

# Optional second OpenAI-compatible fallback, for example OpenRouter.
AI_FALLBACK2_API_URL="https://openrouter.ai/api/v1/chat/completions"
AI_FALLBACK2_API_KEY=""
AI_FALLBACK2_MODEL="openai/gpt-oss-20b:free"
