generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum NodeLevel {
  EXAM
  SUBJECT
  DOMAIN
  TOPIC
  CONCEPT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Whether a chapter's questions can be answered without scratch work.
// Derived from chapter/subject names at import time; a per-question override
// tag ("scratch:none" / "scratch:mental") can win over this for exceptions.
enum ScratchTier {
  NONE // purely mental: vocab, grammar, GK, polity, current affairs
  MENTAL // short mental math: percentages, number system
  WRITTEN // needs working out: SI/CI, time & work, mensuration
}

enum ActivityType {
  LOGIN
  EXAM_SELECTED
  CHAPTER_MARKED
  QUESTION_ANSWERED
  ADAPTIVE_SESSION_STARTED
  ADAPTIVE_SESSION_ENDED
  QUESTION_FLAGGED
  NEWS_VIEWED
  USER_FEEDBACK
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  // Subscription columns, added outside Prisma. Every column is text in the
  // database (including the dates), so these stay String rather than being
  // "cleaned up" into DateTime — that would rewrite the columns.
  subscriptionStatus    String  @default("trial") @map("subscription_status")
  subscriptionPlan      String? @map("subscription_plan")
  subscriptionEndsAt    String? @map("subscription_ends_at")
  subscriptionGrantedBy Int?    @map("subscription_granted_by")
  subscriptionGrantedAt String? @map("subscription_granted_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedExams    UserExam[]
  learnedChapters  UserChapter[]
  attempts         QuestionAttempt[]
  adaptiveSessions AdaptiveSession[]
  activities       UserActivity[]
  questionReports  QuestionReport[]
  newsViews        NewsView[]
  conceptStats     UserConceptStat[]
  flaggedQuestions FlaggedQuestion[]
  pocketSessions   PocketSession[]

  @@map("users")
}

model Exam {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  createdAt   DateTime @default(now())

  subjects  Subject[]
  userExams UserExam[]

  @@map("exams")
}

model Subject {
  id     String @id @default(cuid())
  name   String
  examId String
  order  Int    @default(0)

  exam     Exam      @relation(fields: [examId], references: [id])
  chapters Chapter[]

  @@unique([name, examId])
  @@map("subjects")
}

model Chapter {
  id          String      @id @default(cuid())
  name        String
  subjectId   String
  order       Int         @default(0)
  scratchTier ScratchTier @default(MENTAL)

  subject      Subject       @relation(fields: [subjectId], references: [id])
  questions    Question[]
  userChapters UserChapter[]

  @@unique([name, subjectId])
  @@index([scratchTier])
  @@map("chapters")
}

model Question {
  id            String     @id @default(cuid())
  chapterId     String
  conceptId     Int?
  text          String
  options       Json
  correctOption Int
  explanation   String?
  difficulty    Difficulty @default(MEDIUM)
  tags          String[]
  isActive      Boolean    @default(true)
  // Legacy denormalised exam label. Added outside Prisma and back-filled across
  // every row; nothing in the app reads it, but it is question data and must not
  // be dropped. Modelled so db push stops wanting to remove it.
  exam          String?    @default("ibps")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  chapter       Chapter           @relation(fields: [chapterId], references: [id])
  concept       TaxonomyNode?     @relation(fields: [conceptId], references: [id])
  attempts      QuestionAttempt[]
  reports       QuestionReport[]
  adaptiveItems AdaptiveItem[]
  pocketItems   PocketItem[]
  flaggedBy     FlaggedQuestion[]

  @@index([conceptId])
  @@index([chapterId, isActive])
  @@index([createdAt])
  @@map("questions")
}

model UserExam {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  exam Exam @relation(fields: [examId], references: [id])

  @@unique([userId, examId])
  @@map("user_exams")
}

model UserChapter {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  isLearned Boolean  @default(true)
  learnedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId])
  @@map("user_chapters")
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  selectedOption Int
  isCorrect      Boolean
  timeTaken      Int      @default(0)
  sessionId      String?
  createdAt      DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  question Question         @relation(fields: [questionId], references: [id])
  session  AdaptiveSession? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
  @@map("question_attempts")
}

model AdaptiveSession {
  id             String    @id @default(cuid())
  userId         String
  examId         String?
  focusConceptId Int?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  totalQ         Int       @default(0)
  correctQ       Int       @default(0)
  score          Float     @default(0)

  user     User              @relation(fields: [userId], references: [id])
  attempts QuestionAttempt[]
  items    AdaptiveItem[]

  @@index([focusConceptId])
  @@map("adaptive_sessions")
}

model AdaptiveItem {
  id         String @id @default(cuid())
  sessionId  String
  questionId String
  order      Int

  session  AdaptiveSession @relation(fields: [sessionId], references: [id])
  question Question        @relation(fields: [questionId], references: [id])

  @@index([sessionId])
  @@map("adaptive_items")
}

// Pocket mode — standalone commute-sized practice, fully separate from
// AdaptiveSession/AdaptiveItem. The whole batch is dealt up front so a session
// can be played offline; answers land in PocketItem (idempotent via clientId)
// and are flushed to the shared attempt log + UserConceptStat on reconnect.
model PocketSession {
  id             String    @id @default(cuid())
  userId         String
  batchSize      Int       @default(8)
  quota          Int       @default(70) // % of batch that should be NONE/MENTAL before falling back
  focusConceptId Int?
  totalQ         Int       @default(0)
  correctQ       Int       @default(0)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  user  User         @relation(fields: [userId], references: [id])
  items PocketItem[]

  @@index([userId])
  @@map("pocket_sessions")
}

model PocketItem {
  id             String    @id @default(cuid())
  sessionId      String
  questionId     String
  order          Int
  clientId       String    @unique // client-generated uuid; makes answer sync retry-safe
  selectedOption Int?
  isCorrect      Boolean?
  timeTaken      Int       @default(0)
  answeredAt     DateTime?
  syncedAt       DateTime?

  session  PocketSession @relation(fields: [sessionId], references: [id])
  question Question      @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("pocket_items")
}

// Pre-aggregated per-user per-concept stats — updated on every answer submission.
// Used by the adaptive engine instead of scanning raw attempts, so accuracy
// is always 100% correct regardless of how many total attempts the user has.
// conceptId XOR chapterId is set (never both, never neither).
model UserConceptStat {
  id        String   @id @default(cuid())
  userId    String
  conceptId Int?
  chapterId String?
  total     Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, conceptId])
  @@unique([userId, chapterId])
  @@index([userId])
  @@map("user_concept_stats")
}

model UserActivity {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("user_activities")
}

model QuestionReport {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  reason     String
  details    String?
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@map("question_reports")
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("Current Affairs")
  source      String?
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  views NewsView[]

  @@map("news_items")
}

model NewsView {
  id         String   @id @default(cuid())
  userId     String
  newsItemId String
  viewedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  newsItem NewsItem @relation(fields: [newsItemId], references: [id])

  @@unique([userId, newsItemId])
  @@map("news_views")
}

model TaxonomyNode {
  id            Int       @id
  parentId      Int?
  level         NodeLevel
  nameEnglish   String
  nameMalayalam String?
  nameHindi     String?
  description   String?
  aliases       String[]
  slug          String    @unique
  status        String    @default("draft")
  importance    String    @default("medium")
  difficulty    String    @default("beginner")
  tags          String[]
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parent    TaxonomyNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children  TaxonomyNode[] @relation("NodeTree")
  questions Question[]

  @@index([parentId])
  @@index([level])
  @@map("taxonomy_nodes")
}

model FlaggedQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  reason     String   @default("general")
  details    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("flagged_questions")
}

// ---- Legacy current-affairs tables ----
//
// Created outside Prisma by the retired CA pipeline (the api/cron functions and
// their scripts, since deleted). They hold ~420 rows of scraped news. Nothing in
// the app reads them, but they are data, so they are modelled here rather than
// left for `db push` to drop alongside some unrelated change.
//
// No relations are declared on purpose: ca_quiz_questions.ca_item_id is an
// integer while current_affairs.id is a bigint, which Prisma will not accept as
// a relation. Leaving it a plain column means a future db push may drop that
// one foreign key — a constraint on dead data, no rows affected.
model CurrentAffair {
  id         BigInt  @id @default(autoincrement())
  title      String
  description String?
  content    String?
  category   String?
  source     String?
  sourceUrl  String? @map("source_url")
  link       String? @unique
  imageUrl   String? @map("image_url")
  pubDate    String? @map("pub_date")
  fetchedAt  String? @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("fetched_at")

  @@index([category])
  @@index([pubDate])
  @@map("current_affairs")
}

model CaQuizQuestion {
  id            BigInt  @id @default(autoincrement())
  caItemId      Int?    @map("ca_item_id")
  questionText  String  @map("question_text")
  optionA       String  @map("option_a")
  optionB       String  @map("option_b")
  optionC       String  @map("option_c")
  optionD       String  @map("option_d")
  optionE       String? @map("option_e")
  correctOption String  @map("correct_option")
  explanation   String?
  category      String?
  createdAt     String? @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")

  @@index([category])
  @@map("ca_quiz_questions")
}

model CaFetchLog {
  id               BigInt  @id @default(autoincrement())
  day              String  @unique
  totalInserted    Int     @default(0) @map("total_inserted")
  reclassified     Int     @default(0)
  status           String
  perCat           String? @map("per_cat")
  failedCategories String? @map("failed_categories")
  createdAt        String? @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")

  @@map("ca_fetch_log")
}
