[{"q":"What is the value of 24 ÷ 6 × 3 + 5?","opts":["17","12","9","22"],"a":0,"exp":"24÷6=4, 4×3=12, and 12+5=17. Division and multiplication are performed before addition.","d":"EASY"},{"q":"What is the value of 18 + 6 × 4 − 12 ÷ 3?","opts":["38","42","30","34"],"a":0,"exp":"6×4=24 and 12÷3=4. Therefore, 18+24−4=38.","d":"EASY"},{"q":"What is √144 + √81?","opts":["21","19","23","25"],"a":0,"exp":"√144=12 and √81=9. Hence, 12+9=21.","d":"EASY"},{"q":"What is ∛216 + √64?","opts":["14","12","16","18"],"a":0,"exp":"∛216=6 and √64=8. Therefore, 6+8=14.","d":"EASY"},{"q":"What is 0.75 + 1.25 × 2?","opts":["3.25","4.00","2.50","3.75"],"a":0,"exp":"1.25×2=2.5. Then 0.75+2.5=3.25.","d":"EASY"},{"q":"What is 3/4 + 5/8?","opts":["11/8","9/8","13/8","7/8"],"a":0,"exp":"3/4=6/8. Therefore, 6/8+5/8=11/8.","d":"EASY"},{"q":"What is 2⁵ ÷ 2²?","opts":["8","4","16","32"],"a":0,"exp":"For the same base, subtract exponents: 2⁵÷2²=2³=8.","d":"EASY"},{"q":"What is 5 + [12 − {8 − (3 + 1)}]?","opts":["13","17","9","15"],"a":0,"exp":"(3+1)=4; 8−4=4; 12−4=8; 5+8=13.","d":"MEDIUM"},{"q":"What is 36 ÷ [3 × (2 + 4)] + 7?","opts":["9","11","13","15"],"a":0,"exp":"(2+4)=6; 3×6=18; 36÷18=2; 2+7=9.","d":"MEDIUM"},{"q":"What is (3/5) ÷ (9/10)?","opts":["2/3","3/2","1/3","5/6"],"a":0,"exp":"Dividing by 9/10 means multiplying by 10/9: (3/5)×(10/9)=2/3.","d":"MEDIUM"},{"q":"What is 2.4 × 0.5 + 1.2?","opts":["2.4","1.8","2.0","3.0"],"a":0,"exp":"2.4×0.5=1.2. Therefore, 1.2+1.2=2.4.","d":"MEDIUM"},{"q":"What is √225 − ∛125?","opts":["10","15","20","5"],"a":0,"exp":"√225=15 and ∛125=5. Therefore, 15−5=10.","d":"EASY"},{"q":"What is 4² + 3³ − 5²?","opts":["18","20","22","16"],"a":0,"exp":"4²=16, 3³=27, and 5²=25. Thus, 16+27−25=18.","d":"MEDIUM"},{"q":"What is [48 ÷ {6 + (2 × 3)}] × 5?","opts":["20","30","15","25"],"a":0,"exp":"2×3=6; 6+6=12; 48÷12=4; 4×5=20.","d":"MEDIUM"},{"q":"What is 7/8 − 1/3?","opts":["13/24","11/24","5/24","17/24"],"a":0,"exp":"LCM of 8 and 3 is 24. Thus 7/8=21/24 and 1/3=8/24; difference=13/24.","d":"MEDIUM"},{"q":"What is 0.36 ÷ 0.06 + 2.5?","opts":["8.5","6.5","7.5","9.5"],"a":0,"exp":"0.36÷0.06=6. Therefore, 6+2.5=8.5.","d":"MEDIUM"},{"q":"What is {18 − [6 + (4 − 2)]} × 3?","opts":["24","30","36","18"],"a":0,"exp":"(4−2)=2; 6+2=8; 18−8=10; 10×3=30.","d":"HARD"},{"q":"What is 3 + 2 × [5 − {8 − (3² − 4)}]?","opts":["9","11","13","15"],"a":0,"exp":"3²−4=5; 8−5=3; 5−3=2; 2×2=4; 3+4=7. Thus the correct value is 7.","d":"HARD"},{"q":"What is (0.8)² + (0.6)²?","opts":["1","0.96","1.04","0.84"],"a":0,"exp":"0.8²=0.64 and 0.6²=0.36. Their sum is 1.","d":"MEDIUM"},{"q":"What is [√196 + ∛343] ÷ 3?","opts":["9","8","10","7"],"a":0,"exp":"√196=14 and ∛343=7. Their sum is 21, and 21÷3=7. Therefore, the correct option is 7.","d":"HARD"}]