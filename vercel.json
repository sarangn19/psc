{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm install --prefix frontend && cd frontend && npx tsc && npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
