{
  "framework": null,
  "installCommand": "npm install && node ./node_modules/prisma/build/index.js generate --schema=backend/prisma/schema.prisma",
  "buildCommand": "npm install --prefix frontend && cd frontend && npx tsc && npx vite build",
  "outputDirectory": "dist",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}